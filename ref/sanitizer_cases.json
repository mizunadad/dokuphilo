{
  "source": "egoguard/tools/test_sanitizer.mjs",
  "cases": [
    {
      "input": "yamada123@example.co.jp に送って",
      "expected": "[CONTACT] に送って",
      "note": "メール: 数値置換に壊されない（旧版の最大バグ）"
    },
    {
      "input": "taro.suzuki+ml@corp-mail.com",
      "expected": "[CONTACT]",
      "note": "メール: 記号入り"
    },
    {
      "input": "03-1234-5678 まで",
      "expected": "[CONTACT] まで",
      "note": "電話: 固定"
    },
    {
      "input": "090-1234-5678",
      "expected": "[CONTACT]",
      "note": "電話: 携帯"
    },
    {
      "input": "555-123-4567",
      "expected": "[CONTACT]",
      "note": "電話: 北米形式"
    },
    {
      "input": "https://example.com/secret?id=9 を参照",
      "expected": "[URL] を参照",
      "note": "URL: スキームつき"
    },
    {
      "input": "詳細は internal-wiki.co.jp にあります",
      "expected": "詳細は [URL] にあります",
      "note": "URL: スキームなし"
    },
    {
      "input": "田中部長、ご確認ください",
